<configuration packagingData="true">

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{mm:ss.SSS} %yellow(%X{pcId}) %highlight(%-5level) %yellow([%thread]) %X{offset} %cyan(\(%file:%line\)#%M) %msg%n
            </pattern>
        </encoder>
    </appender>

    <root level="${pc.log.level:-warn}">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Raised from the command line, not by editing: -Dpc.log.level=debug|trace. See docs/testing.md. -->
    <logger name="bz.stub.parallelconsumer" level="${pc.log.level:-warn}"/>

    <!-- Instancio narrates every node it visits at debug, which is one line per field per record. -->
    <logger name="org.instancio" level="warn"/>

</configuration>
