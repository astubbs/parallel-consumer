<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>parallel-consumer-parent</artifactId>
        <groupId>bz.stub.parallelconsumer</groupId>
        <version>0.6.0.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>Parallel Consumer - Sandbox</name>
    <artifactId>parallel-consumer-sandbox</artifactId>
    <description>Runs any Parallel Consumer definition with no broker: the mock consumer that already ships in the
        core artefact, a producer to match, and a driver that publishes at a declared rate - by default filling
        each route's declared type with realistic random data. Also the broker-free test kit.
    </description>

    <properties>
        <!-- THE GENERATOR LIBRARIES ARE PINNED TO LINES THAT STILL RUN ON THIS REACTOR'S RELEASE TARGET (8).
             Verified against the published jars rather than the release notes, because the release notes of all
             three describe the BUILD jdk, not the bytecode:

               instancio-core 5.4.1  - multi-release jar. Every executable class in the base tree is major 52
                                       (Java 8); the only major-53 entries are package-info.class files, which
                                       carry no code, and META-INF/versions/16 holds the records overlay a Java 8
                                       runtime never reads. Its OSGi Require-Capability nonetheless declares
                                       JavaSE 9 because of those package-infos, which is why this comment exists:
                                       an OSGi container is the one deployment that would refuse it.
               datafaker 1.9.0       - major 52 throughout; module-info.class sits under META-INF/versions/9, the
                                       correct multi-release shape. 2.x is Java 17 and is where this moves when
                                       the Java baseline changes (astubbs#53).
               avro 1.11.5           - major 52 throughout; 1.11.4 carried CVE-2025-33042. 1.12 raises the floor to Java 11. Optional: only the
                                       Avro arm of the generator touches it, and that arm is not loaded unless
                                       the class is on the classpath.

             Re-verify before bumping any of these; `unzip -p <jar> <class> | xxd -p -l 8` is the whole check
             (bytes 7-8 are the major version: 0x34 = 52 = Java 8). -->
        <instancio.version>5.4.1</instancio.version>
        <datafaker.version>1.9.0</datafaker.version>
        <avro.version>1.11.5</avro.version>
        <!-- Test only, and only so that the generator's "Protobuf is not supported in this version" refusal is
             proved against a real protobuf message type rather than a stand-in. protobuf-java ships several
             (Int32Value and friends), so no code generation is needed. -->
        <protobuf.version>3.25.5</protobuf.version>
        <!-- One version for both jackson artifacts here, because they are NOT independent: avro 1.11.x pulls
             jackson-core 2.14.3 transitively, maven's nearest-wins picked it over the 2.18 that jackson-databind
             asks for, and the first generated record died on
             `NoSuchMethodError: com.fasterxml.jackson.core.util.BufferRecycler.releaseToPool()` - a 2.18 databind
             calling into a 2.14 core. requireUpperBoundDeps did not catch it because the two arrive in different
             scopes. Declared rather than excluded from avro: avro genuinely needs a jackson-core, it just needs
             the same one. Keep this equal to core's jackson.fluent.version. -->
        <jackson.version>2.18.10</jackson.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>bz.stub.parallelconsumer</groupId>
            <artifactId>parallel-consumer-core</artifactId>
            <version>${project.version}</version>
        </dependency>


        <!-- The object graph. Structure only: it knows how to reach every field of a type, and nothing about
             what a field called "emailAddress" ought to contain - that is Datafaker's half. -->
        <dependency>
            <groupId>org.instancio</groupId>
            <artifactId>instancio-core</artifactId>
            <version>${instancio.version}</version>
        </dependency>

        <!-- The leaf values. Field-name aware, so an "email" is an email and an "amount" is money. -->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>${datafaker.version}</version>
        </dependency>

        <!-- Optional: an Avro specific record is filled from its own schema through Avro's RandomData, which is
             the only generator that understands one. A user with no Avro route never sees this on their
             classpath, and AvroValues is not loaded unless the class is there. -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- See the jackson.version property: this exists to keep avro's transitive jackson-core off the
             classpath, not because anything here calls it. Optional, like the avro it serves. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>bz.stub.parallelconsumer</groupId>
            <artifactId>parallel-consumer-core</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <!-- The fluent API's json(...) format helper resolves Jackson reflectively and core declares it
             optional, so a module that exercises a JSON route has to declare it itself. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
