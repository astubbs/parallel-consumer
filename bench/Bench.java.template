import __PKG__.ParallelConsumerOptions;
import __PKG__.ParallelEoSStreamProcessor;
import __PKG__.vertx.VertxParallelEoSStreamProcessor;

import com.github.tomakehurst.wiremock.WireMockServer;
import com.github.tomakehurst.wiremock.core.WireMockConfiguration;
import org.apache.kafka.clients.admin.Admin;
import org.apache.kafka.clients.admin.NewTopic;
import org.apache.kafka.clients.consumer.ConsumerRecords;
import org.apache.kafka.clients.consumer.KafkaConsumer;
import org.apache.kafka.clients.producer.KafkaProducer;
import org.apache.kafka.clients.producer.ProducerRecord;
import org.apache.kafka.clients.producer.RecordMetadata;

import java.net.HttpURLConnection;
import java.net.URI;
import java.net.URL;
import java.time.Duration;
import java.util.*;
import java.util.concurrent.Future;
import java.util.concurrent.atomic.AtomicInteger;

import static com.github.tomakehurst.wiremock.client.WireMock.*;

/**
 * One measurement, against a broker and a dataset someone else already prepared.
 *
 * The point of the split is that a bisect runs this dozens of times: starting a broker and
 * producing the dataset inside the measured process would put container startup and a few hundred
 * thousand produces into every data point, and would also let the dataset differ between arms.
 * Here the broker and topic are arguments, so every version in the sweep reads THE SAME BYTES from
 * THE SAME BROKER, and the only thing that changes between runs is the classpath.
 *
 * Consumer group is fresh per run, so each run re-reads the topic from the beginning.
 *
 *   Bench produce  <bootstrap> <topic> <count>
 *   Bench vanilla  <bootstrap> <topic> <count> <delayMs>
 *   Bench pc       <bootstrap> <topic> <count> <delayMs> <concurrency> [messageBufferSize]
 *   Bench core     <bootstrap> <topic> <count> <delayMs> <concurrency> [messageBufferSize]
 *
 * "pc" drives the Vert.x engine (an ExternalEngine); "core" drives ParallelEoSStreamProcessor
 * directly. Both are needed because the two take DIFFERENT code paths through the control loop, and
 * a result from one says nothing about the other.
 *
 * Prints one machine-readable result line: RESULT <mode> <count> <ms> <msgPerSec> peak=<maxInFlight>
 *
 * peak is measured at the stub, so it is what the engine actually had outstanding - not what it was
 * configured to allow.
 */
public class Bench {

    static WireMockServer stub;
    static final AtomicInteger responses = new AtomicInteger();

    /**
     * Peak requests being served at once. This is the engine's ACTUAL in-flight count, observed from
     * outside it, and it is the whole reason this harness can tell a throughput change from a
     * dispatch-accounting change: an engine that ignores maxConcurrency looks fast for a reason that
     * has nothing to do with being fast.
     */
    static final AtomicInteger inFlight = new AtomicInteger();
    static final AtomicInteger peakInFlight = new AtomicInteger();

    public static void main(String[] args) throws Exception {
        String mode = args[0], bootstrap = args[1], topic = args[2];
        int count = Integer.parseInt(args[3]);

        if ("produce".equals(mode)) {
            createTopic(bootstrap, topic);
            produce(bootstrap, topic, count);
            System.out.println("RESULT produce " + count + " 0 0");
            return;
        }

        int delayMs = Integer.parseInt(args[4]);
        int concurrency = args.length > 5 ? Integer.parseInt(args[5]) : 0;
        int bufferSize = args.length > 6 ? Integer.parseInt(args[6]) : 0;
        long ms;
        if ("vanilla".equals(mode)) {
            startStub(delayMs, 8);
            ms = runVanilla(bootstrap, topic, count);
        } else if ("core".equals(mode)) {
            ms = runCore(bootstrap, topic, count, delayMs, concurrency, bufferSize);
        } else {
            startStub(delayMs, concurrency * 2);
            ms = runPc(bootstrap, topic, count, concurrency, bufferSize);
        }
        System.out.printf("RESULT %s %d %d %.1f peak=%d%n",
                mode, count, ms, count * 1000.0 / ms, peakInFlight.get());
        if (stub != null) stub.stop();
        System.exit(0);
    }

    static void startStub(int delayMs, int threads) {
        stub = new WireMockServer(WireMockConfiguration.wireMockConfig()
                .dynamicPort().containerThreads(Math.max(threads, 6)));
        stub.stubFor(get(urlPathEqualTo("/")).willReturn(aResponse()));
        stub.addMockServiceRequestListener((rq, rs) -> {
            int now = inFlight.incrementAndGet();
            peakInFlight.accumulateAndGet(now, Math::max);
            sleep(delayMs);
            inFlight.decrementAndGet();
        });
        stub.start();
    }

    static long runVanilla(String bootstrap, String topic, int expected) throws Exception {
        URL url = URI.create("http://localhost:" + stub.port() + "/").toURL();
        int seen = 0;
        long start;
        try (KafkaConsumer<String, String> c = new KafkaConsumer<>(consumerProps(bootstrap))) {
            c.subscribe(Collections.singletonList(topic));
            start = System.currentTimeMillis();
            while (seen < expected) {
                ConsumerRecords<String, String> poll = c.poll(Duration.ofSeconds(1));
                for (Object ignored : poll) {
                    blockingGet(url);
                    if (++seen >= expected) break;
                }
            }
        }
        return System.currentTimeMillis() - start;
    }

    /**
     * Builds options, applying messageBufferSize only if this version has it.
     * <p>
     * Reflection rather than a direct call because the option does not exist in the older releases
     * this harness also compiles against, and one template has to build for all of them.
     */
    static ParallelConsumerOptions<String, String> options(KafkaConsumer<String, String> consumer,
                                                           int concurrency, int bufferSize) throws Exception {
        Object builder = ParallelConsumerOptions.<String, String>builder()
                .ordering(ParallelConsumerOptions.ProcessingOrder.UNORDERED)
                .consumer(consumer)
                .commitMode(ParallelConsumerOptions.CommitMode.PERIODIC_CONSUMER_ASYNCHRONOUS)
                .maxConcurrency(concurrency);
        if (bufferSize > 0) {
            try {
                builder.getClass().getMethod("messageBufferSize", int.class).invoke(builder, bufferSize);
            } catch (NoSuchMethodException absent) {
                System.err.println("NOTE: messageBufferSize not available in this version; ignored");
            }
        }
        @SuppressWarnings("unchecked")
        ParallelConsumerOptions<String, String> built =
                (ParallelConsumerOptions<String, String>) builder.getClass().getMethod("build").invoke(builder);
        return built;
    }

    /** The core engine, which does NOT go through ExternalEngine and its overrides. */
    static long runCore(String bootstrap, String topic, int expected, int delayMs,
                        int concurrency, int bufferSize) throws Exception {
        KafkaConsumer<String, String> consumer = new KafkaConsumer<>(consumerProps(bootstrap));
        ParallelEoSStreamProcessor<String, String> pc =
                new ParallelEoSStreamProcessor<>(options(consumer, concurrency, bufferSize));
        pc.subscribe(Collections.singletonList(topic));
        responses.set(0);
        long start = System.currentTimeMillis();
        // the parameter is deliberately unused, so this lambda compiles against both the old
        // Consumer<ConsumerRecord> signature and the newer Consumer<PollContext> one
        pc.poll(ignored -> {
            int now = inFlight.incrementAndGet();
            peakInFlight.accumulateAndGet(now, Math::max);
            sleep(delayMs);
            inFlight.decrementAndGet();
            responses.incrementAndGet();
        });
        while (responses.get() < expected) sleep(25);
        long took = System.currentTimeMillis() - start;
        try { pc.closeDrainFirst(); } catch (Exception ignored) { }
        return took;
    }

    static long runPc(String bootstrap, String topic, int expected, int concurrency, int bufferSize) throws Exception {
        KafkaConsumer<String, String> consumer = new KafkaConsumer<>(consumerProps(bootstrap));
        VertxParallelEoSStreamProcessor<String, String> pc =
                new VertxParallelEoSStreamProcessor<>(options(consumer, concurrency, bufferSize));
        pc.subscribe(Collections.singletonList(topic));
        responses.set(0);
        long start = System.currentTimeMillis();
        pc.vertxHttpReqInfo(
                record -> new VertxParallelEoSStreamProcessor.RequestInfo("localhost", stub.port(), "/", new HashMap<>()),
                onSend -> { },
                onResponse -> responses.incrementAndGet());
        while (responses.get() < expected) sleep(25);
        long took = System.currentTimeMillis() - start;
        try { pc.closeDrainFirst(); } catch (Exception ignored) { }
        return took;
    }

    static void createTopic(String bootstrap, String topic) {
        Properties p = new Properties();
        p.put("bootstrap.servers", bootstrap);
        try (Admin admin = Admin.create(p)) {
            admin.createTopics(Collections.singletonList(new NewTopic(topic, 1, (short) 1))).all().get();
        } catch (Exception e) {
            // already there is fine - the dataset is produced once and reused
        }
    }

    static void produce(String bootstrap, String topic, int n) throws Exception {
        Properties p = new Properties();
        p.put("bootstrap.servers", bootstrap);
        p.put("key.serializer", "org.apache.kafka.common.serialization.StringSerializer");
        p.put("value.serializer", "org.apache.kafka.common.serialization.StringSerializer");
        p.put("linger.ms", "50");
        p.put("batch.size", "65536");
        List<Future<RecordMetadata>> sends = new ArrayList<>();
        try (KafkaProducer<String, String> pr = new KafkaProducer<>(p)) {
            for (int i = 0; i < n; i++) sends.add(pr.send(new ProducerRecord<>(topic, "key-" + i, "value-" + i)));
        }
        for (Future<RecordMetadata> f : sends) f.get();
    }

    static Properties consumerProps(String bootstrap) {
        Properties p = new Properties();
        p.put("bootstrap.servers", bootstrap);
        p.put("group.id", "bench-" + System.nanoTime());
        p.put("auto.offset.reset", "earliest");
        p.put("enable.auto.commit", "false");
        p.put("max.poll.records", "500");
        p.put("key.deserializer", "org.apache.kafka.common.serialization.StringDeserializer");
        p.put("value.deserializer", "org.apache.kafka.common.serialization.StringDeserializer");
        return p;
    }

    static void blockingGet(URL url) {
        try {
            HttpURLConnection c = (HttpURLConnection) url.openConnection();
            c.setRequestMethod("GET");
            c.getResponseCode();
            c.disconnect();
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    static void sleep(long ms) {
        try { Thread.sleep(ms); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }
    }
}
