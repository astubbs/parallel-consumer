        <dependency>
            <groupId>io.stubbs.truth</groupId>
            <artifactId>truth-generator-api</artifactId>
            <version>${truth-generator-maven-plugin.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>uk.co.jemos.podam</groupId>
            <artifactId>podam</artifactId>
            <version>8.0.2.RELEASE</version>
            <scope>test</scope>
        </dependency>
        <!-- Lincheck - scheduler-controlled concurrency testing (bounded model checking + stress).
             CORE ONLY and TEST ONLY, deliberately: it is Mozilla Public License 2.0, which is
             file-level copyleft and incompatible with shipping inside an Apache-2.0 artifact. As a
             test-scope dependency it is never packaged, never on a consumer's classpath, and never in
             the published pom's compile/runtime graph - the same position jUnit and Mockito hold.
             It also drags in the Kotlin stdlib, kotlin-reflect, kotlinx-coroutines, ASM and
             ByteBuddy; keeping it out of the other four modules keeps that graph in one place.
             Evaluation and calibration result: docs/plans/2026-08-25-001-test-lincheck-poc-plan.md -->
        <dependency>
            <groupId>org.jetbrains.lincheck</groupId>
            <artifactId>lincheck</artifactId>
            <version>3.7</version>
            <scope>test</scope>
        </dependency>
        <!-- ASM core, pinned FORWARD to match the asm-commons/asm-util/asm-analysis 9.9.1 that Lincheck
             brings. Without this the build is green and Lincheck is blind.

             wiremock-jre8 declares org.ow2.asm:asm 9.4 as a DIRECT dependency, so Maven's nearest-wins
             put 9.4 on the test classpath beside Lincheck's 9.9.1 asm-commons. Lincheck's class-file
             transformer then dies inside every transform with
             NoSuchMethodError: org.objectweb.asm.Type.getArgumentCount(String) - a method that only
             exists from ASM 9.6 - and CATCHES it per class, logs it, and carries on with the class
             uninstrumented. The model checker therefore observes no shared-memory accesses, finds no
             interleavings, and reports SUCCESS. A deliberately-buggy control probe passed clean until
             this pin was added; that is how it was found, and it is why LincheckToolchainProbeTest
             exists (docs/plans/2026-08-25-001-test-lincheck-poc-plan.md). -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.9.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Per-module JUnit thread-parallelism - see junit.parallelism.configuration.parameters above
                 for why it lives in the build rather than in a packaged properties file. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <properties>
                        <configurationParameters>${junit.parallelism.configuration.parameters}</configurationParameters>
                    </properties>
                    <!-- ${lincheck.jvm.args} opens the JDK internals Lincheck's MODEL CHECKING strategy needs;
                         @{argLine} preserves whatever JaCoCo's prepare-agent put there, which a plain <argLine>
                         would silently replace (and the coverage report would then be empty, with a green build).
                         Root pom declares an empty argLine property so this still resolves under -Djacoco.skip.
                         Why it is needed and what it costs: docs/plans/2026-08-25-001-test-lincheck-poc-plan.md -->
                    <!-- -Dpc.log.dir gives every fork its own directory. The seven FileAppenders in
                         src/test/resources/logback-test.xml are plain, non-prudent FileAppenders on fixed
                         paths, and the ci profile runs surefire at forkCount=1C with reuseForks - so one
                         JVM per core would otherwise hold a handle on each of the same seven files.
                         Non-prudent appenders are not safe for multiple JVMs on one file, and the two
                         streams that promise EVERY error and EVERY warning for the whole run are exactly
                         the ones that would lose writes.

                         Why a directory per fork rather than <prudent>: prudent mode buys one shared path
                         at the cost of unbuffered, file-locked writes on all seven appenders, on every
                         line. Read across the forks instead - `cat target/pc-logs/fork-*/errors.log`.

                         ${pc.log.dir} is a property so a caller can still redirect the root
                         (-Dpc.log.dir=/tmp/run-3), and ${surefire.forkNumber} is left for surefire to
                         expand per fork - Maven passes unknown properties through untouched.

                         FAILSAFE IS DELIBERATELY NOT GIVEN THIS - but NOT for the reason this comment
                         used to give. It said failsafe "declares no forkCount, so it runs at the
                         default of 1". It declares none here, but .github/workflows/maven.yml runs the
                         gating Integration Tests lane with -DforkCount=4, and with no <forkCount> pinned
                         below, failsafe takes that bare user property - the same -DforkCount vs
                         -Dsurefire.forkCount trap noted a few lines above, in the direction that bites.
                         So four failsafe JVMs already share one flat pc.log.dir, which is exactly the
                         multi-JVM-on-one-file case described above, and raising forkCount further
                         worsens it rather than introducing it.

                         The path stays flat anyway, on the surviving half of the original reason: the
                         bin/ experiment runners record a flat
                         <their -Dpc.log.dir>/probes.log path for a reader to open, which a fork
                         subdirectory would break. (They CLASSIFY from the run log, not from the silo -
                         the violation and the trajectory land in different silos, and only the run log
                         has both. Their headers say so.) -->
                    <argLine>@{argLine} ${lincheck.jvm.args} -Dpc.log.dir=${pc.log.dir}/fork-${surefire.forkNumber}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <properties>
                        <configurationParameters>${junit.parallelism.configuration.parameters}</configurationParameters>
                    </properties>
                </configuration>
            </plugin>

            <plugin>
                <groupId>io.stubbs.truth</groupId>
                <artifactId>truth-generator-maven-plugin</artifactId>
                <version>${truth-generator-maven-plugin.version}</version>
                <configuration>
                    <cleanTargetDir>false</cleanTargetDir>
                    <useHas>false</useHas>
                    <useGetterForLegacyClasses>true</useGetterForLegacyClasses>
                    <releaseTarget>8</releaseTarget>
                    <classes>
                        <class>bz.stub.parallelconsumer.PollContext</class>
                        <class>bz.stub.parallelconsumer.ParallelEoSStreamProcessor</class>
                        <class>bz.stub.parallelconsumer.internal.ProducerManager</class>
                        <class>bz.stub.parallelconsumer.state.WorkContainer</class>
                        <class>bz.stub.parallelconsumer.state.WorkManager</class>
                        <class>bz.stub.parallelconsumer.state.PartitionState</class>
                        <class>bz.stub.parallelconsumer.state.ProcessingShard</class>
                        <class>bz.stub.parallelconsumer.state.ShardKey</class>
                        <class>bz.stub.parallelconsumer.offsets.OffsetEncoding</class>
                    </classes>
                    <legacyClasses>
                        <!-- todo check legacy is recursive -->
                        <class>org.apache.kafka.clients.consumer.OffsetAndMetadata</class>
                        <class>org.apache.kafka.clients.consumer.ConsumerRecord</class>
                        <class>org.apache.kafka.clients.consumer.ConsumerRecords</class>
                        <class>org.apache.kafka.clients.consumer.Consumer</class>
                        <class>org.apache.kafka.clients.producer.RecordMetadata</class>
                        <class>org.apache.kafka.clients.producer.ProducerRecord</class>
                        <class>org.apache.kafka.clients.producer.Producer</class>
                    </legacyClasses>
                    <entryPointClassPackage>bz.stub.parallelconsumer</entryPointClassPackage>
                </configuration>
                <executions>
                    <execution>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


</project>
