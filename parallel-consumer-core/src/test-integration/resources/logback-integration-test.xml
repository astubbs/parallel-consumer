<!--

    Copyright (C) 2026 Antony Stubbs and contributors

    INTEGRATION-TEST logging profile. NOT loaded by default.

    Select it explicitly at runtime:
        -Dlogback.configurationFile=logback-integration-test.xml

    Named differently from the unit profile ON PURPOSE. Both used to be logback-test.xml and both
    copied to target/test-classes, so which one won was decided by file timestamp - the integration
    suite's logging config was effectively nondeterministic. A distinct name plus an explicit switch
    replaces that coin flip.

    PROVE which config loaded rather than assuming:
        -Dlogback.statusListenerClass=ch.qos.logback.core.status.OnConsoleStatusListener
    Logback then prints the URL of the file it read. Reach for it whenever a logging change appears
    to have had no effect - the usual cause is that it was never loaded, and that failure is silent.

    Levels are property-driven like the unit profile. They used to be hardcoded to debug on six
    per-record loggers, which is what produced a 126MB chaos job log.

    docs/logging.md owns the why.
-->
<configuration packagingData="true" scan="true" scanPeriod="5 seconds" debug="false">

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{mm:ss.SSS} %yellow(%X{pcId}) %highlight(%-5level) %yellow([%thread]) %X{offset} %cyan(\(%file:%line\)#%M) %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- KNOWN, and left alone deliberately on 2026-09-01 - do not "fix" this in one line.

         The header above says levels are property-driven. That is true of the six named subsystem
         loggers and NOT of the two pins here: this root, and the bz.stub.parallelconsumer logger
         below, are both bare literals, so -Dpc.log.level does not reach PC's own loggers in this
         profile.

         The obvious repair - making this root ${pc.log.level:-info} - looks right and achieves
         nothing: the package pin below overrides root for every PC logger, so the flag would only
         raise third-party loggers nobody pinned (testcontainers, docker-java). That is noise, not
         signal. The two pins have to be decided together, and the decision is not free - the header
         records that hardcoded levels here once produced a 126MB chaos job log.

         Nothing goes red either way: bin/check-test-log-config.sh scopes itself to the four library
         modules' src/test/resources/logback-test.xml and does not cover this file. -->
    <!-- The same siloed streams the unit profile gets. Shared rather than copied: this profile had
         NONE, and because nothing selects it that was invisible - the integration suite falls back
         to logback-test.xml and got the silos by accident. Selecting this profile as the header
         above instructs would have silently dropped every stream. -->
    <include resource="logback-silos.xml"/>

    <root level="info">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="ERRORS"/>
        <appender-ref ref="WARNINGS"/>
    </root>

    <!-- PC state management — DEBUG to capture epoch, stale container, and rebalance events
         without the overwhelming volume of TRACE on 500k records -->
    <logger name="bz.stub.parallelconsumer.state.PartitionStateManager" level="${pc.log.level:-info}"/>
    <logger name="bz.stub.parallelconsumer.state.ProcessingShard" level="${pc.log.level:-info}"/>
    <logger name="bz.stub.parallelconsumer.state.ShardManager" level="${pc.log.level:-info}"/>
    <logger name="bz.stub.parallelconsumer.state.PartitionState" level="${pc.log.level:-info}"/>
    <logger name="bz.stub.parallelconsumer.state.RemovedPartitionState" level="${pc.log.level:-info}"/>
    <logger name="bz.stub.parallelconsumer.internal.BrokerPollSystem" level="${pc.log.level:-info}"/>

    <!-- Keep general PC at info to reduce noise -->
    <logger name="bz.stub.parallelconsumer" level="info"/>

    <!-- Suppress noisy external loggers -->
    <logger name="org.apache.kafka" level="warn"/>
    <!-- The two coordinator classes are raised SEPARATELY, on their own property, because they are the
         only Kafka loggers that say whether a closing member sent LeaveGroup and what generation it
         held at close - the discriminator for the CLOSING-state zombie-member stall
         (docs/inflight/test-largenumberofinstances-residual-failures-measured-not-explained.md).
         Raising all of org.apache.kafka to see two lines floods the run; a committed debug default is
         what bin/check-test-log-config.sh exists to refuse. Default stays warn.
             -Dkafka.coordinator.log.level=debug -Dit.test=ClosingMemberRebalanceIT -->
    <logger name="org.apache.kafka.clients.consumer.internals.AbstractCoordinator" level="${kafka.coordinator.log.level:-warn}"/>
    <logger name="org.apache.kafka.clients.consumer.internals.ConsumerCoordinator" level="${kafka.coordinator.log.level:-warn}"/>
    <logger name="org.apache.kafka.common.config.AbstractConfig" level="error"/>
    <logger name="bz.stub.parallelconsumer.integrationTests.BrokerIntegrationTest" level="warn"/>
    <logger name="org.postgresql" level="info"/>
    <logger name="io.netty" level="info"/>
    <logger name="pl.tlinkowski" level="warn"/>

</configuration>
