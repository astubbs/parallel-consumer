/mk-include
/.mk-include-timestamp
.DS_Store
CLAUDE.md

# Local per-worktree ownership markers (see AGENTS.md "Worktree ownership")
.worktree-owner

# Agent / assistant tooling state. All of this is local to one checkout - session
# transcripts, caches, machine-specific config - and none of it is meaningful to
# another contributor. `.claude` is ignored by CONTENTS (`/*`, not the directory) so
# that shared config can be un-ignored later with a negation, e.g.
# `!/.claude/settings.json`; git will not descend into a fully-excluded directory.
/.claude/*
# ...which is now done: the shared harness config is tracked, personal overrides are not.
# settings.local.json stays ignored - it is where per-machine permission grants accumulate.
# See docs/agent-harness.md.
!/.claude/settings.json
!/.claude/hooks/
!/.claude/hooks/**
/.codebuddy/
/.context/
/.compound-engineering/

# Local worktree roots (AGENTS.md "Worktree ownership" puts worktrees under
# .claude/worktrees; .worktrees is the other root in use). Covered by /.claude/*
# above, listed separately because it is the one contributors trip over.
/.worktrees/

# Editor-local settings (personal preference, not project convention)
/.vscode/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

*.versionsBackup

# JENV
.java-version

delombok/
**/*.releaseBackup

# User-specific stuff
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/sonarlint/
.idea/libraries/


# Generated files
.idea/**/contentModel.xml

# Gradle and Maven with auto-import
# When using Gradle or Maven with auto-import, you should exclude module files,
# since they will be recreated, and may cause churn.  Uncomment if using
# auto-import.
.idea/artifacts
.idea/compiler.xml
.idea/jarRepositories.xml
.idea/modules.xml
.idea/*.iml
.idea/modules
*.iml
*.ipr

# Mongo Explorer plugin
.idea/**/mongoSettings.xml

# File-based project format
*.iws

# Maven
target
release.properties
/.idea/encodings.xml
/.idea/misc.xml
/.idea/codeStyles/Project.xml
/.idea/inspectionProfiles/Project_Default.xml
/.idea/uiDesigner.xml
/.idea/vcs.xml
