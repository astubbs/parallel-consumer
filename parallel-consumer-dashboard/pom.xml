<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>bz.stub.parallelconsumer</groupId>
        <artifactId>parallel-consumer-parent</artifactId>
        <version>0.6.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>parallel-consumer-dashboard</artifactId>
    <name>Kafka Parallel Consumer Dashboard</name>
    <description>
        Experimental, opt-in embedded web dashboard showing what a running Parallel Consumer instance is
        doing right now. Read-only. Nothing starts unless the application explicitly starts it.
    </description>

    <modelVersion>4.0.0</modelVersion>

    <properties>
        <!--
            Deliberately module-local, mirroring parallel-consumer-vertx rather than being promoted to the
            parent. This repo has a recorded scar from a global pin: pinning jackson-databind in the parent
            broke WireMock in the vertx module, and the fix was to keep it module-local. Same shape, same
            treatment.
        -->
        <vertx.version>4.5.31</vertx.version>
        <!--
            The chart library ships as an ordinary Maven dependency and is served straight off the classpath
            from META-INF/resources/webjars/. It is deliberately NOT committed to the repository: a
            third-party build product in git goes stale the first time the UI changes and sits in every
            clone forever.
        -->
        <uplot.version>1.6.30</uplot.version>
        <!--
            THE UI TEST HARNESS (plan U15/KTD22). Both are test scope only, and module-local for the same
            reason as the versions above.

            GraalVM's JavaScript engine runs the page's own ES modules on the JVM, so the arithmetic the
            page is built on - BigInt offsets above 2^53, span widths, row ordering, number formatting - is
            gated by the ordinary unit suite with no browser anywhere. It is not small (about 60MB resolved,
            most of it ICU and Truffle) and that is the price of being the only engine on the JVM that runs
            ES modules and BigInt as written: Nashorn has neither, and Rhino has no ES modules. 23.0.x is
            the GraalVM-for-JDK-17 line, which is the JDK this repository builds and tests on; 23.1 and
            later need JDK 21.

            Selenium drives a real browser for the half GraalVM cannot do: the live DOM and screenshots. It
            is the chrome-driver artifact rather than selenium-java (about 22MB rather than the full
            aggregate), and it drives whatever Chrome is already on the machine - so it downloads no browser
            of its own, and the suite skips itself cleanly where there is no browser to find. Playwright was
            the alternative and its driver bundle alone is a 198MB Maven artifact, before any browser.
        -->
        <graaljs.version>23.0.13</graaljs.version>
        <selenium.version>4.36.0</selenium.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>bz.stub.parallelconsumer</groupId>
            <artifactId>parallel-consumer-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>bz.stub.parallelconsumer</groupId>
            <artifactId>parallel-consumer-core</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>

        <!-- External -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
            <version>${vertx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>uplot</artifactId>
            <version>${uplot.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- see the graaljs.version / selenium.version comment above for why these two, and what they cost -->
        <dependency>
            <groupId>org.graalvm.js</groupId>
            <artifactId>js</artifactId>
            <version>${graaljs.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-chrome-driver</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-junit5</artifactId>
            <version>${vertx.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>me.tongfei</groupId>
            <artifactId>progressbar</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Needed by the core test-jar classes this module's integration tests reuse rather than
            reimplement - BrokerIntegrationTest reaches for StringUtils and RandomUtils while building
            the Testcontainers broker. It is test-scoped in core, and test scope is not transitive, so
            without this the demo dies at class-initialisation time with a NoClassDefFoundError.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
    </dependencies>

</project>
