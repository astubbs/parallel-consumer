<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>parallel-consumer-proxy-clients</artifactId>
        <groupId>bz.stub.parallelconsumer</groupId>
        <version>0.6.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>Parallel Consumer - Proxy Client Swift</name>
    <artifactId>parallel-consumer-proxy-client-swift</artifactId>
    <packaging>pom</packaging>

    <!--
        Thin Maven wrapper over Swift Package Manager (Package.swift beside this file). The
        commands below run ONLY under -Dpc.foreignClients - see the foreign-clients profile in the
        clients aggregator for why opt-in is load-bearing. Skeleton until the Swift wave of the
        language-proxy plan (astubbs#242) starts; that wave owns everything in this directory,
        including refining these commands.
    -->
    <properties>
        <pc.foreign.skip>false</pc.foreign.skip>
        <pc.foreign.build.executable>swift</pc.foreign.build.executable>
        <pc.foreign.build.args>build</pc.foreign.build.args>
        <pc.foreign.test.executable>swift</pc.foreign.test.executable>
        <pc.foreign.test.args>test</pc.foreign.test.args>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
