<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>parallel-consumer-proxy-clients</artifactId>
        <groupId>bz.stub.parallelconsumer</groupId>
        <version>0.6.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>Parallel Consumer - Proxy Client Swift</name>
    <artifactId>parallel-consumer-proxy-client-swift</artifactId>
    <packaging>pom</packaging>

    <!--
        Thin Maven wrapper over the Swift toolchain. This module is in the reactor only under
        -Dpc.foreignClients - see the foreign-clients profile in the clients aggregator for why
        opt-in is load-bearing - and all it does today is build a program that prints one fixture
        line and check that it did (astubbs#242).

        Package.swift beside this pom is the language-native build file. The scratch-path flag moves
        SwiftPM's output out of its default .build/ and under target/, so Maven's default clean
        removes it; the package declares no dependencies, so the build needs no network.

        NOT A CONTAINER, where the source branch uses one: Swift is containerised there because
        Swift.org publishes no build for the distribution that branch's C++ client also needs.
        A hello fixture needs the swift toolchain and nothing else, and requiring Docker for it
        would put a second thing in the way of the check.

        Both commands go through bin/foreign-client-step.sh, which decides what an ABSENT swift
        means: a banner and a skip by default, red under -Dpc.foreign.strict=1, which is what the
        CI row passes. The commands themselves are declared here and nowhere else.
    -->
    <properties>
        <pc.foreign.skip>false</pc.foreign.skip>
        <pc.foreign.build.executable>bash</pc.foreign.build.executable>
        <pc.foreign.build.args>${pc.foreign.step} --tool swift -- swift build --scratch-path target/swift --configuration release</pc.foreign.build.args>
        <pc.foreign.test.executable>bash</pc.foreign.test.executable>
        <pc.foreign.test.args>${pc.foreign.step} --tool swift --hello swift -- target/swift/release/hello</pc.foreign.test.args>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <!--
                NO maven-clean-plugin FILESET HERE, and that is a decision rather than an omission -
                "nothing to clean" and "nobody wired the clean" look identical in a pom. Everything
                this module builds lands under target/, which Maven's default clean already takes.
                the scratch-path flag puts SwiftPM's output under target/, which the default clean takes.
            -->
        </plugins>
    </build>

</project>
