<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>parallel-consumer-proxy-clients</artifactId>
        <groupId>bz.stub.parallelconsumer</groupId>
        <version>0.6.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>Parallel Consumer - Proxy Client Python</name>
    <artifactId>parallel-consumer-proxy-client-python</artifactId>
    <packaging>pom</packaging>

    <!--
        Thin Maven wrapper over the Python client's own tooling (pyproject.toml beside this file).
        The commands below run ONLY under -Dpc.foreignClients - see the foreign-clients profile in
        the clients aggregator for why opt-in is load-bearing. Skeleton until the Python wave of
        the language-proxy plan (astubbs#242) starts; that wave owns everything in this directory,
        including refining these commands.
    -->
    <properties>
        <pc.foreign.skip>false</pc.foreign.skip>
        <pc.foreign.build.executable>python3</pc.foreign.build.executable>
        <pc.foreign.build.args>-m compileall src</pc.foreign.build.args>
        <pc.foreign.test.executable>python3</pc.foreign.test.executable>
        <pc.foreign.test.args>-m pytest</pc.foreign.test.args>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
