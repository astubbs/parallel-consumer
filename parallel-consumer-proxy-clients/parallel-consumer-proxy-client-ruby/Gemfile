# frozen_string_literal: true

# The Ruby client of the language-proxy plan (astubbs#242). The pom.xml beside this file wraps the
# module into the Maven reactor under -Dpc.foreignClients.
#
# EVERY VERSION IS PINNED EXACTLY, generators included. `grpc-tools` carries the protoc and the
# Ruby gRPC plugin that scripts/generate-proto.sh regenerates the committed stubs with, so the
# regeneration is reproducible from this file rather than from whatever protoc happens to be on
# PATH - the same discipline the Go client's `tool` directives apply to its generators.

source "https://rubygems.org"

# The client's own runtime dependencies. `google-protobuf` arrives transitively with `grpc`; it is
# named anyway because the generated message classes are its API and the version is load-bearing
# (the committed stubs were generated against it).
gem "google-protobuf", "4.35.1"
gem "grpc", "1.83.0"

group :development, :test do
  # protoc + protoc-gen-grpc-ruby, at the same version as the runtime, for
  # scripts/generate-proto.sh. Nothing is installed globally.
  gem "grpc-tools", "1.83.0"

  gem "rake", "13.4.2"
  gem "rspec", "3.13.2"

  # Bug-finding, not style arbitration - see .rubocop.yml, which turns the style departments off
  # and leaves Lint/ and Security/ at full strength.
  gem "rubocop", "1.89.0"

  # The DEPENDENCY auditor, as opposed to rubocop's source auditing: it reads Gemfile.lock against
  # the ruby-advisory-db and reports gems with published advisories (astubbs#242). Pinned here for
  # the same reason as everything else in this file - bin/client-audit.sh runs `bundle exec
  # bundler-audit`, so the version a developer runs and the version the clients workflow's Ruby row
  # runs cannot drift, and nothing is installed globally.
  #
  # Its exit code alone is not a verdict: bundler-audit exits 1 both when it finds an advisory and
  # when it cannot find Gemfile.lock at all. bin/client-audit.sh reads its JSON report and tells
  # those apart - see that script's header.
  gem "bundler-audit", "0.9.3"
end
